  "engine_files": {
    "hosts": "127.0.0.1 localhost\n::1 localhost\n",
    "hostname": "tackle-isolated-worker\n",
    "resolv.conf": ""
  },
  "participant_env": {
    "HOME": "/work",
    "TMPDIR": "/tmp",
    "PATH": "/usr/local/bin:/usr/bin:/bin",
    "LANG": "C.UTF-8",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "image_env_names": [
    "GPG_KEY",
    "PYTHON_VERSION",
    "PYTHON_SHA256",
    "PATH",
    "LANG"
  ],
  "tool_schemas": [
    {
      "description": "Return a requested byte range from a readable file as UTF-8 text.",
      "name": "Read",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "byte_offset": {
            "minimum": 0,
            "type": "integer"
          },
          "file_path": {
            "minLength": 1,
            "type": "string"
          },
          "max_bytes": {
            "maximum": 65536,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file_path",
          "byte_offset",
          "max_bytes"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "Write UTF-8 content to a writable file and return the acknowledged result.",
      "name": "Write",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 1048576,
            "type": "string"
          },
          "file_path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file_path",
          "content"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    },
    {
      "description": "Run bounded arbitrary shell command text in an owned working directory and return host-observed native component bytes.",
      "name": "Bash",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 65536,
            "minLength": 1,
            "type": "string"
          },
          "cwd": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "command",
          "cwd"
        ],
        "type": "object"
      },
      "strict": true,
      "type": "function"
    }
  ],
  "limits": [
    "network_none does not prohibit every own-loopback socket",
    "Docker default seccomp retained; no custom profile",
    "Engine removal is component lifecycle evidence, not a direct cgroup task census",
    "No Responses, C07_accepted or C20_accepted, private chain or live acceptance"
  ]
}
